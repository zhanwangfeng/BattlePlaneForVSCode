{
  "name": "battle-plane-vscode",
  "displayName": "BattlePlane",
  "description": "VS Code 里的经典「炸飞机」小游戏：在 10×10 棋盘摆放 3 架飞机，轰炸并击落敌方全部机头即获胜。",
  "version": "0.3.0",
  "publisher": "zhanwangfeng",
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "battle",
    "plane",
    "炸飞机",
    "game",
    "飞机",
    "游戏"
  ],
  "files": [
    "out",
    "resources",
    "src/webview",
    "src/multi/webview",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "node_modules/ws"
  ],
  "activationEvents": [
    "onView:battlePlane.start",
    "onCommand:battlePlane.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "battlePlane",
          "title": "炸飞机",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "battlePlane": [
        {
          "id": "battlePlane.start",
          "name": "开始",
          "icon": "resources/icon.png",
          "contextualTitle": "炸飞机"
        }
      ]
    },
    "commands": [
      {
        "command": "battlePlane.open",
        "title": "炸飞机：打开游戏"
      },
      {
        "command": "battlePlane.openSite",
        "title": "炸飞机：打开网页版",
        "icon": "$(share)"
      },
      {
        "command": "battlePlane.restart",
        "title": "炸飞机：重开一局"
      },
      {
        "command": "battlePlane.multiCreate",
        "title": "炸飞机：创建联机房"
      },
      {
        "command": "battlePlane.multiJoin",
        "title": "炸飞机：加入联机房"
      }
    ],
    "configuration": {
      "title": "炸飞机 联机设置",
      "properties": {
        "battlePlane.multiPort": {
          "type": "number",
          "default": 19101,
          "minimum": 1,
          "maximum": 65535,
          "description": "局域网联机使用的 WebSocket 端口（房主与加入方需一致）。"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "battlePlane.openSite",
          "when": "view == battlePlane.start",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --noEmit -p ./ && esbuild src/extension.ts --bundle --platform=node --target=node16 --outfile=out/extension.js --external:vscode --external:ws",
    "watch": "tsc --noEmit -p ./ & esbuild src/extension.ts --bundle --platform=node --target=node16 --outfile=out/extension.js --external:vscode --external:ws --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.1",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhanwangfeng/BattlePlaneForVSCode.git"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
